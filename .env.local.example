# ─────────────────────────────────────────────────────────────
# Cecilia's Home — environment variables
# Copy to .env.local for local development. All are OPTIONAL:
# without them, the contact form still works (it logs the inquiry
# server-side and returns success). Add these to enable email.
# ─────────────────────────────────────────────────────────────

# Resend — sends an email when the contact form is submitted.
RESEND_API_KEY=re_your_api_key

# Where contact-form inquiries are emailed.
# Defaults to the address in lib/brand.ts if unset.
CONTACT_INQUIRY_EMAIL=ceciliashomellc@gmail.com

# Verified "from" address for Resend (must be on a verified domain).
# Defaults to Resend's onboarding sender for testing.
CONTACT_FROM_EMAIL="Cecilia's Home Website <onboarding@resend.dev>"
